# =============================================================================
# GROUPME BOTS - ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains all environment variables needed for the multi-platform
# bot system including GroupMe, Discord, Telegram, Signal, and e-commerce integrations.

# -----------------------------------------------------------------------------
# CORE APPLICATION SETTINGS
# -----------------------------------------------------------------------------

# Project Configuration
PROJECT_NAME=Group_Me_Bots
VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your_secret_key_here_generate_with_python_secrets_token_urlsafe_32
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# -----------------------------------------------------------------------------
# GROUPME API CONFIGURATION (Primary Platform)
# -----------------------------------------------------------------------------

# GroupMe API Configuration
ZB_PROMO=your_groupme_access_token_here

# Alternative tokens (for multiple accounts)
ZB_PROMO_SECONDARY=BxqbDXTL1uWYbFVeYFLwYyhloIOb1aS3mMMQOO60
TWIN_NEM_TOKEN=tL3KIMhqTZO1mfpkzoqhgHhMcT1dHaQaLwwhbHPF

# Bot Configuration
BOT_NAME=Zort Pro
BOT_AVATAR_URL=https://i.groupme.com/225x225.png.d628db9eb2e648f9bfa206caf4043bef

# Image Upload Token (for posting images)
IMAGE_UPLOAD_TOKEN=sfWtsmhMR1II4z7WKxPqtXXV7ny10lM1SDnn0QbV

# -----------------------------------------------------------------------------
# DISCORD BOT CONFIGURATION
# -----------------------------------------------------------------------------

# Discord Bot Token (get from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord Application/Client Configuration
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Discord Server/Guild IDs (configure your specific server IDs)
DISCORD_MAIN_GUILD_ID=your_main_discord_server_id

# -----------------------------------------------------------------------------
# TELEGRAM BOT CONFIGURATION
# -----------------------------------------------------------------------------

# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Webhook Configuration (optional - for webhook mode)
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook

# Telegram Admin User IDs (comma-separated for multiple admins)
TELEGRAM_ADMIN_IDS=123456789,987654321

# -----------------------------------------------------------------------------
# SIGNAL API CONFIGURATION
# -----------------------------------------------------------------------------

# Signal CLI REST API Configuration
SIGNAL_API_HOST=localhost
SIGNAL_API_PORT=8080

# Signal Phone Numbers (for multiple Signal accounts)
SIGNAL_PHONE_NUMBER_1=+1234567890
SIGNAL_PHONE_NUMBER_2=+1987654321

# Signal API Authentication (if required)
SIGNAL_API_KEY=your_signal_api_key_if_needed

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------

# Primary Database (SQLite by default, change for PostgreSQL/MySQL)
DATABASE_URL=sqlite+aiosqlite:///./groupme_bots.db

# Alternative Database URLs (uncomment and configure as needed)
# DATABASE_URL=postgresql://username:password@localhost:5432/groupme_bots
# DATABASE_URL=mysql://username:password@localhost:3306/groupme_bots

# -----------------------------------------------------------------------------
# E-COMMERCE INTEGRATIONS
# -----------------------------------------------------------------------------

# Shopify Integration
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token
SHOPIFY_STORE_URL=your-store.myshopify.com

# WooCommerce Integration
WOOCOMMERCE_URL=https://your-store.com
WOOCOMMERCE_CONSUMER_KEY=your_woocommerce_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=your_woocommerce_consumer_secret

# -----------------------------------------------------------------------------
# PAYMENT PROCESSING
# -----------------------------------------------------------------------------

# Stripe Configuration
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# PayPal Configuration (if used)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION (for caching and sessions)
# -----------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_PASSWORD=

# Alternative Redis configuration
# REDIS_URL=redis://username:password@host:port/database

# -----------------------------------------------------------------------------
# AWS CONFIGURATION (for S3, SES, etc.)
# -----------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# AWS SES (for email sending)
AWS_SES_REGION=us-east-1
AWS_SES_SOURCE_EMAIL=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# EXTERNAL API KEYS AND SERVICES
# -----------------------------------------------------------------------------

# Reddit API (if using Reddit integrations)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=GroupMeBots/1.0

# Pushbullet API (for notifications)
PUSHBULLET_API_KEY=your_pushbullet_api_key

# Twitter API (if using Twitter integrations)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_token_secret

