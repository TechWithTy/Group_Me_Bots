# -----------------------------------------------------------------------------
# RATE LIMITING AND PERFORMANCE
# -----------------------------------------------------------------------------

# Rate limiting (requests per minute per endpoint)
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Request timeout settings (in seconds)
REQUEST_TIMEOUT=30
API_TIMEOUT=10

# Worker configuration
MAX_WORKERS=4
WORKER_TIMEOUT=300

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------

# Comma-separated list of allowed origins for CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://your-domain.com

# -----------------------------------------------------------------------------
# DEVELOPMENT AND TESTING
# -----------------------------------------------------------------------------

# Test mode (disables external API calls)
TEST_MODE=false

# Mock external services (for development)
MOCK_EXTERNAL_APIS=false

# Development database reset (WARNING: destroys data)
RESET_DB_ON_START=false

# -----------------------------------------------------------------------------
# BACKUP AND MIGRATION
# -----------------------------------------------------------------------------

# Backup configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_DESTINATION=./backups

# Migration settings
MIGRATION_ENABLED=false
MIGRATION_SOURCE_PLATFORM=
MIGRATION_TARGET_PLATFORM=

# -----------------------------------------------------------------------------
# MONITORING AND ANALYTICS
# -----------------------------------------------------------------------------

# Analytics tracking
ANALYTICS_ENABLED=false
ANALYTICS_TRACKING_ID=

# Health check endpoints
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# Metrics collection
METRICS_ENABLED=false
METRICS_COLLECTION_INTERVAL=60

# -----------------------------------------------------------------------------
# FILE STORAGE AND MEDIA
# -----------------------------------------------------------------------------

# Media storage configuration
MEDIA_STORAGE_TYPE=local
MEDIA_STORAGE_PATH=./media

# Alternative: AWS S3
# MEDIA_STORAGE_TYPE=s3
# MEDIA_S3_BUCKET=your-media-bucket

# File upload limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,mp4,mp3,pdf

# -----------------------------------------------------------------------------
# NOTIFICATIONS AND ALERTS
# -----------------------------------------------------------------------------

# Email notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Admin notification settings
ADMIN_NOTIFICATION_EMAILS=admin@yourdomain.com
NOTIFICATION_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# INTEGRATION WEBHOOKS
# -----------------------------------------------------------------------------

# Discord webhooks (for cross-platform notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Slack webhooks (if using Slack integrations)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-slack-webhook

# Generic webhook for external integrations
GENERIC_WEBHOOK_URL=https://your-service.com/webhook

# -----------------------------------------------------------------------------
# PLATFORM-SPECIFIC SETTINGS
# -----------------------------------------------------------------------------

# GroupMe-specific settings
GROUPME_AUTO_JOIN_GROUPS=true
GROUPME_MESSAGE_COOLDOWN=5

# Discord-specific settings
DISCORD_AUTO_JOIN_GUILDS=true
DISCORD_COMMAND_PREFIX=!

# Telegram-specific settings
TELEGRAM_AUTO_JOIN_GROUPS=true
TELEGRAM_MESSAGE_COOLDOWN=3

# Signal-specific settings
SIGNAL_AUTO_REGISTER=true
SIGNAL_MESSAGE_COOLDOWN=2

# -----------------------------------------------------------------------------
# ADVANCED FEATURES
# -----------------------------------------------------------------------------

# AI/Prompt Engineering features
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=your_ai_api_key
AI_MODEL=gpt-3.5-turbo

# Natural Language Processing
NLP_ENABLED=false
NLP_LANGUAGE=en

# Auto-moderation settings
AUTO_MODERATION_ENABLED=false
TOXICITY_THRESHOLD=0.8
SPAM_DETECTION_ENABLED=true

# Content filtering
CONTENT_FILTER_ENABLED=false
PROFANITY_FILTER=true
LINK_PREVIEW_ENABLED=true

# -----------------------------------------------------------------------------
# PERFORMANCE OPTIMIZATION
# -----------------------------------------------------------------------------

# Caching configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE_MB=100

# Database connection pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# API response compression
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6

# -----------------------------------------------------------------------------
# SECURITY SETTINGS
# -----------------------------------------------------------------------------

# API key authentication
API_KEY_ENABLED=false
API_KEY_NAME=X-API-Key

# JWT settings (for API authentication)
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=your_jwt_secret_key

# Rate limiting per IP
RATE_LIMIT_PER_IP=true
RATE_LIMIT_BURST=10

# Request size limits
MAX_REQUEST_SIZE_MB=50

# -----------------------------------------------------------------------------
# DEBUGGING AND DEVELOPMENT TOOLS
# -----------------------------------------------------------------------------

# Enable debug endpoints
DEBUG_ENDPOINTS_ENABLED=false

# API request logging
LOG_API_REQUESTS=false

# Database query logging
LOG_DB_QUERIES=false

# Performance profiling
PROFILING_ENABLED=false

# Hot reload for development
HOT_RELOAD=true

# -----------------------------------------------------------------------------
# PRODUCTION OVERRIDES
# -----------------------------------------------------------------------------

# Production-specific settings (these will override development settings)
# Uncomment and set these when deploying to production

# PRODUCTION_HOST=your-production-domain.com
# PRODUCTION_PORT=443
# PRODUCTION_DEBUG=false
# PRODUCTION_LOG_LEVEL=WARNING
# PRODUCTION_DATABASE_URL=postgresql://prod_username:prod_password@prod_host:5432/prod_db
# PRODUCTION_REDIS_URL=redis://prod_redis_host:6379/0

# SSL/TLS configuration for production
# SSL_CERT_PATH=/path/to/certificate.pem
# SSL_KEY_PATH=/path/to/private.key

# Production monitoring
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# PRODUCTION_METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# LEGACY/CUSTOM SETTINGS
# -----------------------------------------------------------------------------

# Custom settings for specific use cases or legacy integrations
# Add any project-specific environment variables here

# Example custom settings:
# CUSTOM_FEATURE_FLAG=true
# LEGACY_API_ENDPOINT=https://legacy-api.example.com/v1

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. Copy this file to .env in the project root
# 2. Replace all 'your_*_here' placeholders with actual values
# 3. Generate secure random strings for SECRET_KEY and other security tokens
# 4. Test configuration with: python -c "from app.telegram.core.config import settings; print('Config loaded successfully')"
# 5. Never commit .env file to version control
#
# For production deployment:
# - Use strong, unique values for all secrets
# - Enable SSL/TLS encryption
# - Configure proper database credentials
# - Set up monitoring and alerting
# - Use environment-specific configuration files
#
# =============================================================================
